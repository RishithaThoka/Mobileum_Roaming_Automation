# Copy this file to .env and fill in real values to enable live email sending.
# Works with any standard SMTP provider — SendGrid, AWS SES, Postmark, Mailgun, etc.
# If left unset, the app runs in SIMULATED mode: approval emails are generated
# and logged in full (visible in the portal's Audit & Email log page) but not
# actually delivered. This lets you demo the whole workflow with zero setup.

# --- SendGrid example ---
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=roaming-control@yourdomain.com

# --- AWS SES example ---
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=AKIAxxxxxxxxxxxxxxxx
# SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMTP_FROM=roaming-control@yourdomain.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Base URL the portal is reachable at — used to build the Approve/Reject
# magic links inside approval emails. Change this to your real deployed URL.
PORTAL_BASE_URL=http://localhost:4021

# Heartbeat poller — simulates the "portal checks the operator's side on a
# schedule" ingestion mode. Every operator set to ingest_mode='heartbeat' gets
# a watch folder at backend/heartbeat-watch/<operator_id>/; the poller scans
# every operator's folder on this interval and auto-ingests any new or
# changed file through the same diff + workflow pipeline as a manual upload.
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_MS=20000

PORT=4021

# --- AI (Gemini) ---
# Get a free key at https://aistudio.google.com/apikey — no card needed to start.
# Before handling real client documents, switch to a BILLED Gemini project
# (or Vertex AI) — Google's free tier may use inputs to improve its models;
# the paid tier and Vertex AI contractually do not.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro
ENABLE_AI_EXTRACTOR=true
ENABLE_AI_CLASSIFIER=true
ENABLE_AI_OPERATOR_DETECTION=true
